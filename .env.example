# Gemini API Key (Optional: for AI Simplifier advanced rewrites)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# --- Option 1: Supabase Direct PostgreSQL URI (Recommended) ---
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Session Mode)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Option 2: Supabase REST API (Project URL + API Key) ---
# Found in: Supabase Dashboard -> Project Settings -> API
# Example:
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SUPABASE_URL=
SUPABASE_KEY=
